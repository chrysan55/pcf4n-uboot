From: PCF4N bring-up <pcf4n@example.invalid>
Subject: [PATCH] plat: agilex5: print BL33 preflight state

The FPGA-first flow reaches the final EL3 exit but U-Boot proper does not
print.  Report the first BL33 words, DDR and UART firewall registers, and the
EL2 state after context preparation so a bad load, denied non-secure access,
or bad exception-level setup is visible before ERET.
---
 plat/intel/soc/agilex5/bl31_plat_setup.c | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/plat/intel/soc/agilex5/bl31_plat_setup.c b/plat/intel/soc/agilex5/bl31_plat_setup.c
index 2b731132f..9dd547a8a 100644
--- a/plat/intel/soc/agilex5/bl31_plat_setup.c
+++ b/plat/intel/soc/agilex5/bl31_plat_setup.c
@@ -389,9 +389,34 @@ void setup_clusterectlr_el1(void)
 	asm volatile("msr S3_0_C15_C3_4, %0" :: "r"(value));
 }
 
+#define PCF4N_BL33_BASE			U(0x80200000)
+#define PCF4N_DDR_FW_DMI0_BASE		U(0x18000800)
+#define PCF4N_DDR_FW_DMI1_BASE		U(0x18000a00)
+#define PCF4N_L4_UART1_FW		U(0x10d21070)
+
+static void pcf4n_dump_ddr_fw(uintptr_t base, const char *name)
+{
+	NOTICE("SOCFPGA: DDR FW %s en=%08x mpu=%08x:%08x-%08x:%08x "
+	       "nonmpu=%08x:%08x-%08x:%08x\n", name,
+	       mmio_read_32(base + 0x00),
+	       mmio_read_32(base + 0x14), mmio_read_32(base + 0x10),
+	       mmio_read_32(base + 0x1c), mmio_read_32(base + 0x18),
+	       mmio_read_32(base + 0x94), mmio_read_32(base + 0x90),
+	       mmio_read_32(base + 0x9c), mmio_read_32(base + 0x98));
+}
+
 void bl31_plat_runtime_setup(void)
 {
-	/* TODO: Dummy */
+	const uint32_t *bl33 = (const uint32_t *)PCF4N_BL33_BASE;
+
+	NOTICE("SOCFPGA: BL33 preflight @0x%x: %08x %08x %08x %08x\n",
+	       PCF4N_BL33_BASE, bl33[0], bl33[1], bl33[4], bl33[10]);
+	pcf4n_dump_ddr_fw(PCF4N_DDR_FW_DMI0_BASE, "dmi0");
+	pcf4n_dump_ddr_fw(PCF4N_DDR_FW_DMI1_BASE, "dmi1");
+	NOTICE("SOCFPGA: UART1 FW=%08x EL2 hcr=%lx sctlr=%lx "
+	       "vbar=%lx sp=%lx\n",
+	       mmio_read_32(PCF4N_L4_UART1_FW), read_hcr_el2(),
+	       read_sctlr_el2(), read_vbar_el2(), read_sp_el2());
 }
 
 void bl31_plat_enable_mmu(uint32_t flags)
-- 
