// SPDX-License-Identifier: GPL-2.0

#include "socfpga_agilex5.dtsi"

/ {
	model = "PCF4N Agilex 5 DPU";
	compatible = "pcf4n,agilex5-dpu", "intel,socfpga-agilex5";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		ethernet0 = &gmac2;
		i2c0 = &i2c0;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i3c0 = &i3c0;
		i3c1 = &i3c1;
		usb0 = &usb0;
		usb1 = &usb31;
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		/* HPS GPIO27 is GPIO1/port B line 3; eMMC reset is active low. */
		reset-gpios = <&portb 3 GPIO_ACTIVE_LOW>;
	};

	memory {
		device_type = "memory";
		/* SPL replaces this with the Quartus handoff result. */
		reg = <0 0 0 0>;
	};

	soc {
		clocks {
			osc1 {
				clock-frequency = <25000000>;
			};
		};
	};
};

&gmac0 {
	status = "disabled";
};

&gmac1 {
	status = "disabled";
};

&gmac2 {
	status = "okay";
	phy-mode = "rgmii";
	phy-handle = <&emac2_phy1>;
	max-frame-size = <9000>;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwxgmac-mdio";

		emac2_phy1: ethernet-phy@1 {
			reg = <1>;
		};
	};
};

&i2c0 {
	/* Optical module 0 management. */
	status = "okay";
};

&i2c2 {
	/* I2C_EMAC0 is wired as the board power-management bus. */
	status = "okay";
};

&i2c3 {
	/* I2C_EMAC1 is wired to optical module 1 management. */
	status = "okay";
};

&i2c4 {
	/* I2C_EMAC2 shares pins with MDIO2; EMAC2 PHY management owns them. */
	status = "disabled";
};

&i3c0 {
	/* Optical module 2 management. */
	status = "okay";
};

&i3c1 {
	/* Optical module 3 management. */
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&mmc {
	status = "okay";
	bus-width = <4>;
	non-removable;
	no-sd;
	no-sdio;
	disable-wp;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-pwrseq = <&emmc_pwrseq>;
	/* The device core is powered at 3.3 V; its I/O rail is fixed at 1.8 V. */
	vmmc-supply = <&sd_emmc_power>;
	vqmmc-supply = <&emmc_io_1v8_reg>;
	/*
	 * The board routes DAT0..DAT3 only. Preserve the production SD6HC 200 MHz
	 * base-clock field and mask only its unconnected eight-bit capability.
	 * The FPGA HPS handoff must provide a matching 200 MHz SoftPHY clock.
	 */
	sdhci-caps-mask = <0x00000000 0x00040000>;
	max-frequency = <200000000>;

	/* Altera Agilex 5 eMMC-variant Legacy-mode timing configuration. */
	cdns,phy-dqs-timing-delay-sd-ds = <0x00780000>;
	cdns,phy-gate-lpbk-ctrl-delay-sd-ds = <0x81a40040>;
	cdns,phy-dll-slave-ctrl-sd-ds = <0x00a000fe>;
	cdns,phy-dq-timing-delay-sd-ds = <0x28000001>;

	/* Altera Agilex 5 eMMC-variant MMC HS/52 SDR timing configuration. */
	cdns,phy-dqs-timing-delay-emmc-sdr = <0x00780001>;
	cdns,phy-gate-lpbk-ctrl-delay-emmc-sdr = <0x81a40040>;
	cdns,phy-dll-slave-ctrl-emmc-sdr = <0x00000000>;
	cdns,phy-dq-timing-delay-emmc-sdr = <0x10000001>;
	cdns,ctrl-hrs09-timing-delay-emmc-sdr = <0x0001800c>;
	cdns,ctrl-hrs10-lpbk-ctrl-delay-emmc-sdr = <0x00030000>;
	cdns,ctrl-hrs16-slave-ctrl-emmc-sdr = <0x00000101>;
	cdns,ctrl-hrs07-timing-delay-emmc-sdr = <0x000a0001>;

	/* Altera Agilex 5 200 MHz eMMC HS200 profile; CMD21 tunes the read path. */
	cdns,phy-dq-timing-delay-emmc-hs200 = <0x10000001>;
	cdns,phy-dqs-timing-delay-emmc-hs200 = <0x00780004>;
	cdns,phy-dll-slave-ctrl-emmc-hs200 = <0x004d4d00>;
	cdns,phy-gate-lpbk-ctrl-delay-emmc-hs200 = <0x81a40040>;
	cdns,phy-dll-master-ctrl-emmc-hs200 = <0x00000004>;
	cdns,ctrl-hrs09-timing-delay-emmc-hs200 = <0xf1c18000>;
	cdns,ctrl-hrs10-lpbk-ctrl-delay-emmc-hs200 = <0x00090000>;
	cdns,ctrl-hrs16-slave-ctrl-emmc-hs200 = <0x00000101>;
	cdns,ctrl-hrs07-timing-delay-emmc-hs200 = <0x000a0001>;
};

&qspi {
	status = "okay";

	flash0: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "macronix,mx25u51245g", "jedec,spi-nor";
		reg = <0>;
		/*
		 * Keep the first HPS-side QSPI reads deliberately conservative.
		 * SDM still configures the FPGA from this device in AS x4 mode; this
		 * setting controls only the Cadence controller after HPS ownership.
		 */
		spi-max-frequency = <25000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
	};
};

&uart0 {
	status = "okay";
};

&uart1 {
	/* L4 SP is 100 MHz in the Quartus handoff and SPL clock report. */
	clock-frequency = <100000000>;
	status = "okay";
};
