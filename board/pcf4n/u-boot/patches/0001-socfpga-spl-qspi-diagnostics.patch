From: PCF4N bring-up <pcf4n@example.invalid>
Subject: [PATCH] arm: socfpga: expose SPL QSPI handoff and probe failures

The Agilex 5 SPL ignored the return value from mbox_qspi_open(), then hid the
SPI-NOR probe result while mapping the device-tree boot order. This reduced a
QSPI ownership, reference-clock, controller, or JEDEC failure to a generic
"no valid element" message.

Print both errors so FPGA-first board bring-up can distinguish SDM mailbox
handoff failures from SPI-NOR probe failures.
---
 arch/arm/mach-socfpga/spl_agilex5.c | 8 ++++++--
 arch/arm/mach-socfpga/spl_soc64.c   | 10 ++++++++--
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/arch/arm/mach-socfpga/spl_agilex5.c b/arch/arm/mach-socfpga/spl_agilex5.c
index 563008dc..9633b7b0 100644
--- a/arch/arm/mach-socfpga/spl_agilex5.c
+++ b/arch/arm/mach-socfpga/spl_agilex5.c
@@ -125,8 +125,12 @@ void board_init_f(ulong dummy)
 	if (IS_ENABLED(CONFIG_SPL_MMC))
 		writel(SECURE_TRANS_SET, SECURE_TRANS_REG);
 
-	if (IS_ENABLED(CONFIG_CADENCE_QSPI))
-		mbox_qspi_open();
+	if (IS_ENABLED(CONFIG_CADENCE_QSPI)) {
+		ret = mbox_qspi_open();
+		if (ret)
+			printf("QSPI: mailbox direct-mode init failed: %d (0x%x)\n",
+			       ret, ret);
+	}
 
 	/* Enable non secure access to ocram */
 	clrbits_le32(SOCFPGA_OCRAM_FIREWALL_ADDRESS + 0x18, BIT(0));
diff --git a/arch/arm/mach-socfpga/spl_soc64.c b/arch/arm/mach-socfpga/spl_soc64.c
index 22d821ca..6e1512a5 100644
--- a/arch/arm/mach-socfpga/spl_soc64.c
+++ b/arch/arm/mach-socfpga/spl_soc64.c
@@ -24,12 +24,18 @@ static int spl_node_to_boot_device(int node)
 	const void *blob = gd->fdt_blob;
 	struct udevice *parent;
 	const char *prop;
+	int ret;
 
 	if (!uclass_get_device_by_of_offset(UCLASS_MMC, node, &parent))
 		return BOOT_DEVICE_MMC1;
-	else if (!uclass_get_device_by_of_offset(UCLASS_SPI_FLASH, node, &parent))
+
+	ret = uclass_get_device_by_of_offset(UCLASS_SPI_FLASH, node, &parent);
+	if (!ret)
 		return BOOT_DEVICE_SPI;
-	else if (!uclass_get_device_by_of_offset(UCLASS_MTD, node, &parent))
+
+	printf("SPL: SPI flash probe for %s failed: %d\n",
+	       fdt_get_name(blob, node, NULL), ret);
+	if (!uclass_get_device_by_of_offset(UCLASS_MTD, node, &parent))
 		return BOOT_DEVICE_NAND;
 
 	prop = fdt_getprop(blob, node, "device_type", NULL);
-- 
