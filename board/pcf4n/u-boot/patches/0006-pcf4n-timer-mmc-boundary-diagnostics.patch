From: PCF4N bring-up <pcf4n@example.invalid>
Subject: [PATCH] timer: trace the PCF4N timer/MMC boundary

The first enabled APB timer reaches its missing-reset warning while Cadence
MMC initialization is running, but that warning does not prove either that
the timer probe completed or that MMC is the next failing component.  Trace
every potentially blocking timer operation, verify that its counter advances,
and bracket the Cadence SD6HC PHY and SDHCI probe stages.
---
 drivers/mmc/sdhci-cadence.c  | 52 ++++++++++++++++++++++++++++++------
 drivers/mmc/sdhci-cadence6.c | 16 +++++++++++
 drivers/timer/dw-apb-timer.c | 51 +++++++++++++++++++++++++++++++----
 3 files changed, 105 insertions(+), 14 deletions(-)

diff --git a/drivers/mmc/sdhci-cadence.c b/drivers/mmc/sdhci-cadence.c
index 8a848115..d979b075 100644
--- a/drivers/mmc/sdhci-cadence.c
+++ b/drivers/mmc/sdhci-cadence.c
@@ -250,22 +250,36 @@ static int sdhci_cdns_probe(struct udevice *dev)
 	struct sdhci_cdns_plat *plat = dev_get_plat(dev);
 	struct sdhci_host *host = dev_get_priv(dev);
 	struct reset_ctl_bulk reset_bulk;
+	bool pcf4n_diag = of_machine_is_compatible("pcf4n,agilex5-dpu");
 	fdt_addr_t base;
 	int ret;
 
+	if (pcf4n_diag)
+		puts("[mmc:cdns>]");
+
 	base = dev_read_addr(dev);
 	if (base == FDT_ADDR_T_NONE)
 		return -EINVAL;
+	if (pcf4n_diag)
+		printf("[mmc:base=%lx]", (ulong)base);
 
 	plat->hrs_addr = devm_ioremap(dev, base, SZ_1K);
 	if (!plat->hrs_addr)
 		return -ENOMEM;
+	if (pcf4n_diag)
+		puts("[mmc:map]");
 
 	ret = reset_get_bulk(dev, &reset_bulk);
-	if (ret)
-		dev_warn(dev, "Can't get reset: %d\n", ret);
-	else
-		reset_deassert_bulk(&reset_bulk);
+	if (ret) {
+		if (pcf4n_diag)
+			printf("[mmc:reset=%d]", ret);
+		else
+			dev_warn(dev, "Can't get reset: %d\n", ret);
+	} else {
+		ret = reset_deassert_bulk(&reset_bulk);
+		if (pcf4n_diag)
+			printf("[mmc:deassert=%d]", ret);
+	}
 
 	host->name = dev->name;
 	host->ioaddr = plat->hrs_addr + SDHCI_CDNS_SRS_BASE;
@@ -276,27 +290,45 @@ static int sdhci_cdns_probe(struct udevice *dev)
 	sdhci_cdns_mmc_ops.execute_tuning = sdhci_cdns_execute_tuning;
 #endif
 
+	if (pcf4n_diag)
+		puts("[mmc:parse>]");
 	ret = mmc_of_parse(dev, &plat->cfg);
+	if (pcf4n_diag)
+		printf("[mmc:parse=%d]", ret);
 	if (ret)
 		return ret;
 
+	if (pcf4n_diag)
+		puts("[mmc:phy>]");
 	if (device_is_compatible(dev, "cdns,sd6hc"))
 		ret = sdhci_cdns6_phy_init(dev, plat);
 	else
 		ret = sdhci_cdns_phy_init(plat, gd->fdt_blob, dev_of_offset(dev));
+	if (pcf4n_diag)
+		printf("[mmc:phy=%d]", ret);
 	if (ret)
 		return ret;
 
 	host->mmc = &plat->mmc;
 	host->mmc->dev = dev;
+	if (pcf4n_diag)
+		puts("[mmc:cfg>]");
 	ret = sdhci_setup_cfg(&plat->cfg, host, plat->cfg.f_max, 0);
+	if (pcf4n_diag)
+		printf("[mmc:cfg=%d]", ret);
 	if (ret)
 		return ret;
 
 	upriv->mmc = &plat->mmc;
 	host->mmc->priv = host;
 
-	return sdhci_probe(dev);
+	if (pcf4n_diag)
+		puts("[mmc:sdhci>]");
+	ret = sdhci_probe(dev);
+	if (pcf4n_diag)
+		printf("[mmc:sdhci=%d][mmc:cdns<]\n", ret);
+
+	return ret;
 }
 
 static const struct udevice_id sdhci_cdns_match[] = {
diff --git a/drivers/mmc/sdhci-cadence6.c b/drivers/mmc/sdhci-cadence6.c
index bee10038..de0d33b4 100644
--- a/drivers/mmc/sdhci-cadence6.c
+++ b/drivers/mmc/sdhci-cadence6.c
@@ -203,9 +203,13 @@ int sdhci_cdns6_phy_adj(struct udevice *dev, struct sdhci_cdns_plat *plat, u32 m
 {
 	struct sdhci_cdns6_phy_cfg *sdhci_cdns6_phy_cfgs;
 	struct sdhci_cdns6_ctrl_cfg *sdhci_cdns6_ctrl_cfgs;
+	bool pcf4n_diag = of_machine_is_compatible("pcf4n,agilex5-dpu");
 	u32 tmp;
 	int i, ret;
 
+	if (pcf4n_diag)
+		printf("[phy:mode=%u]", mode);
+
 	switch (mode) {
 	case UHS_SDR12:
 	case MMC_LEGACY:
@@ -254,15 +258,23 @@ int sdhci_cdns6_phy_adj(struct udevice *dev, struct sdhci_cdns_plat *plat, u32 m
 		dev_read_u32(dev, sdhci_cdns6_ctrl_cfgs[i].property, &sdhci_cdns6_ctrl_cfgs[i].val);
 
 	/* Switch On the DLL Reset */
+	if (pcf4n_diag)
+		puts("[phy:rst-on>]");
 	sdhci_cdns6_reset_phy_dll(plat, true);
+	if (pcf4n_diag)
+		puts("[phy:rst-on<][phy:regs>]");
 
 	sdhci_cdns6_write_phy_reg(plat, PHY_DQS_TIMING_REG_ADDR, sdhci_cdns6_phy_cfgs[0].val);
 	sdhci_cdns6_write_phy_reg(plat, PHY_GATE_LPBK_CTRL_REG_ADDR, sdhci_cdns6_phy_cfgs[1].val);
 	sdhci_cdns6_write_phy_reg(plat, PHY_DLL_MASTER_CTRL_REG_ADDR, sdhci_cdns6_phy_cfgs[4].val);
 	sdhci_cdns6_write_phy_reg(plat, PHY_DLL_SLAVE_CTRL_REG_ADDR, sdhci_cdns6_phy_cfgs[2].val);
+	if (pcf4n_diag)
+		puts("[phy:regs<][phy:rst-off>]");
 
 	/* Switch Off the DLL Reset */
 	ret = sdhci_cdns6_reset_phy_dll(plat, false);
+	if (pcf4n_diag)
+		printf("[phy:rst-off=%d]", ret);
 	if (ret) {
 		printf("sdhci_cdns6_reset_phy is not completed\n");
 		return ret;
@@ -291,6 +303,8 @@ int sdhci_cdns6_phy_adj(struct udevice *dev, struct sdhci_cdns_plat *plat, u32 m
 
 	/* Set HRS07 register */
 	writel(sdhci_cdns6_ctrl_cfgs[3].val, plat->hrs_addr + SDHCI_CDNS_HRS07);
+	if (pcf4n_diag)
+		puts("[phy:done]");
 
 	return 0;
 }
diff --git a/drivers/timer/dw-apb-timer.c b/drivers/timer/dw-apb-timer.c
index f9270a27..992d88df 100644
--- a/drivers/timer/dw-apb-timer.c
+++ b/drivers/timer/dw-apb-timer.c
@@ -50,8 +50,13 @@ static int dw_apb_timer_probe(struct udevice *dev)
 {
 	struct timer_dev_priv *uc_priv = dev_get_uclass_priv(dev);
 	struct dw_apb_timer_priv *priv = dev_get_priv(dev);
+	bool pcf4n_diag = of_machine_is_compatible("pcf4n,agilex5-dpu");
 	struct clk clk;
+	u32 count_before, count_after;
 	int ret;
+
+	if (pcf4n_diag)
+		printf("[tmr:probe@%lx]", (ulong)priv->regs);
 #if CONFIG_IS_ENABLED(OF_PLATDATA)
 	struct dw_apb_timer_plat *plat = dev_get_plat(dev);
 	struct dtd_snps_dw_apb_timer *dtplat = &plat->dtplat;
@@ -66,23 +71,55 @@ static int dw_apb_timer_probe(struct udevice *dev)
 #endif
 	if (CONFIG_IS_ENABLED(OF_REAL)) {
 		ret = reset_get_bulk(dev, &priv->resets);
-		if (ret)
-			dev_warn(dev, "Can't get reset: %d\n", ret);
-		else
-			reset_deassert_bulk(&priv->resets);
-
+		if (ret) {
+			if (pcf4n_diag)
+				printf("[tmr:reset=%d]", ret);
+			else
+				dev_warn(dev, "Can't get reset: %d\n", ret);
+		} else {
+			ret = reset_deassert_bulk(&priv->resets);
+			if (pcf4n_diag)
+				printf("[tmr:deassert=%d]", ret);
+		}
+
+		if (pcf4n_diag)
+			puts("[tmr:clk>]");
 		ret = clk_get_by_index(dev, 0, &clk);
-		if (ret)
+		if (ret) {
+			if (pcf4n_diag)
+				printf("[tmr:clk=%d]\n", ret);
 			return ret;
+		}
 
 		uc_priv->clock_rate = clk_get_rate(&clk);
+		if (pcf4n_diag)
+			printf("[tmr:rate=%lu]", uc_priv->clock_rate);
 	}
 
 	/* init timer */
+	if (pcf4n_diag)
+		puts("[tmr:load>]");
 	writel(0xffffffff, priv->regs + DW_APB_LOAD_VAL);
+	if (pcf4n_diag)
+		puts("[tmr:load<][tmr:curr>]");
 	writel(0xffffffff, priv->regs + DW_APB_CURR_VAL);
+	if (pcf4n_diag)
+		puts("[tmr:curr<][tmr:ctrl>]");
 	setbits_le32(priv->regs + DW_APB_CTRL, 0x3);
+	if (pcf4n_diag) {
+		puts("[tmr:ctrl<]");
+		count_before = readl(priv->regs + DW_APB_CURR_VAL);
+		__socfpga_udelay(10);
+		count_after = readl(priv->regs + DW_APB_CURR_VAL);
+		printf("[tmr:count=%08x>%08x]", count_before, count_after);
+		if (count_before == count_after) {
+			puts("[tmr:stalled]\n");
+			return -ETIMEDOUT;
+		}
+	}
 
 	gd->timer = dev;
+	if (pcf4n_diag)
+		puts("[tmr:ok]\n");
 	return 0;
 }
