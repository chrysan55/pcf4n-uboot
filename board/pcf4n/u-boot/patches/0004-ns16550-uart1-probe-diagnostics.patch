From: PCF4N bring-up <pcf4n@example.invalid>
Subject: [PATCH] serial: ns16550: trace PCF4N UART1 probe

The BL33 entry diagnostics reach serial_init() but not the early console.
Trace UART1 device-tree translation, clock selection, reset deassertion, and
the NS16550 transmitter-empty wait through the already working raw UART.
Keep the diagnostics out of SPL so its established console path is unchanged.
---
 drivers/serial/ns16550.c | 56 ++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 55 insertions(+), 1 deletion(-)

diff --git a/drivers/serial/ns16550.c b/drivers/serial/ns16550.c
index 4f7de3ea..75a41749 100644
--- a/drivers/serial/ns16550.c
+++ b/drivers/serial/ns16550.c
@@ -21,6 +21,44 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
+#if defined(CONFIG_TARGET_SOCFPGA_AGILEX5) && !defined(CONFIG_XPL_BUILD)
+#define PCF4N_EARLY_UART1_BASE	0x10c02100UL
+
+static void pcf4n_uart_diag_putc(char ch)
+{
+	void __iomem *uart = (void __iomem *)PCF4N_EARLY_UART1_BASE;
+
+	while (!(readl(uart + 0x14) & UART_LSR_THRE))
+		;
+	writel(ch, uart);
+}
+
+static void pcf4n_uart_diag_puts(const char *text)
+{
+	while (*text)
+		pcf4n_uart_diag_putc(*text++);
+}
+
+static void pcf4n_uart_diag_hex(u32 value)
+{
+	static const char digits[] = "0123456789abcdef";
+	int shift;
+
+	for (shift = 28; shift >= 0; shift -= 4)
+		pcf4n_uart_diag_putc(digits[(value >> shift) & 0xf]);
+}
+#else
+static inline void pcf4n_uart_diag_puts(const char *text)
+{
+	(void)text;
+}
+
+static inline void pcf4n_uart_diag_hex(u32 value)
+{
+	(void)value;
+}
+#endif
+
 #define UART_LCRVAL UART_LCR_8N1		/* 8 data, 1 stop, no parity */
 #define UART_MCRVAL (UART_MCR_DTR | \
 		     UART_MCR_RTS)		/* RTS/DTR */
@@ -240,8 +278,12 @@ void ns16550_init(struct ns16550 *com_port, int baud_divisor)
 	}
 #endif
 
+	pcf4n_uart_diag_puts("[temt=");
+	pcf4n_uart_diag_hex(serial_in(&com_port->lsr));
+	pcf4n_uart_diag_puts("]");
 	while (!(serial_in(&com_port->lsr) & UART_LSR_TEMT))
 		;
+	pcf4n_uart_diag_puts("[temt<]");
 
 	serial_out(CFG_SYS_NS16550_IER, &com_port->ier);
 #if defined(CONFIG_ARCH_OMAP2PLUS) || defined(CONFIG_OMAP_SERIAL)
@@ -504,6 +546,8 @@ int ns16550_serial_probe(struct udevice *dev)
 	fdt_addr_t size;
 	int ret;
 
+	pcf4n_uart_diag_puts("[probe>]");
+
 	/*
 	 * If we are on PCI bus, either directly attached to a PCI root port,
 	 * or via a PCI bridge, assign plat->base before probing hardware.
@@ -517,10 +561,14 @@ int ns16550_serial_probe(struct udevice *dev)
 
 	ret = reset_get_bulk(dev, &reset_bulk);
 	if (!ret)
-		reset_deassert_bulk(&reset_bulk);
+		ret = reset_deassert_bulk(&reset_bulk);
+	pcf4n_uart_diag_puts("[rst=");
+	pcf4n_uart_diag_hex(ret);
+	pcf4n_uart_diag_puts("]");
 
 	com_port->plat = dev_get_plat(dev);
 	ns16550_init(com_port, -1);
+	pcf4n_uart_diag_puts("[probe<]");
 
 	return 0;
 }
@@ -542,11 +590,14 @@ int ns16550_serial_of_to_plat(struct udevice *dev)
 	struct clk clk;
 	int err;
 
+	pcf4n_uart_diag_puts("[of>]");
+
 	addr = not_xpl() ? dev_read_addr_size(dev, &size) :
 		dev_read_addr(dev);
 	err = ns16550_serial_assign_base(plat, addr, size);
 	if (err && !device_is_on_pci_bus(dev))
 		return err;
+	pcf4n_uart_diag_puts("[addr]");
 
 	plat->reg_offset = dev_read_u32_default(dev, "reg-offset", 0);
 	plat->reg_shift = dev_read_u32_default(dev, "reg-shift", 0);
@@ -571,6 +622,9 @@ int ns16550_serial_of_to_plat(struct udevice *dev)
 		debug("ns16550 clock not defined\n");
 		return -EINVAL;
 	}
+	pcf4n_uart_diag_puts("[clk=");
+	pcf4n_uart_diag_hex(plat->clock);
+	pcf4n_uart_diag_puts("]");
 
 	plat->fcr = UART_FCR_DEFVAL;
 	if (port_type == PORT_JZ4780)
-- 
2.39.5
