<pfg version="1">
    <!-- FPGA Configuration First: intentionally omit the HPS-first hps option. -->
    <settings custom_db_dir="./" mode="ASX4"/>
    <output_files>
        <output_file name="pcie_ed_hps" directory="./output_jic/" type="PERIPH_JIC">
            <file_options/>
            <secondary_file type="MAP" name="pcie_ed_hps">
                <file_options/>
            </secondary_file>
            <secondary_file type="SEC_RPD" name="pcie_ed_hps">
                <file_options bitswap="1"/>
            </secondary_file>
            <flash_device_id>Flash_Device_1</flash_device_id>
        </output_file>
    </output_files>
    <bitstreams>
        <bitstream id="Bitstream_1">
            <path hps_path="u-boot-spl-dtb.hex">./output_jic/pcie_ed.sof</path>
        </bitstream>
    </bitstreams>
    <raw_files>
        <!-- u-boot.bin is the complete FIT and is byte-identical to u-boot.itb. -->
        <raw_file bitswap="1" type="RBF" id="Raw_File_1">u-boot.bin</raw_file>
    </raw_files>
    <flash_devices>
        <flash_loader>A5ED065BB32AE4S</flash_loader>
        <flash_device type="MX25U512" id="Flash_Device_1">
            <partition reserved="1" fixed_s_addr="1" s_addr="0x00000000" e_addr="0x002FFFFF" fixed_e_addr="1" id="BOOT_INFO" size="0"/>
            <!-- SPL reads the FIT from this fixed 0x00300000 address. -->
            <partition reserved="0" fixed_s_addr="1" s_addr="0x00300000" e_addr="0x005FFFFF" fixed_e_addr="1" id="UBOOT" size="0"/>
            <!-- The complete FPGA-first bitstream follows the 3 MiB FIT allocation. -->
            <partition reserved="0" fixed_s_addr="1" s_addr="0x00600000" e_addr="auto" fixed_e_addr="0" id="P1" size="0"/>
        </flash_device>
    </flash_devices>
    <assignments>
        <assignment page="0" partition_id="P1">
            <bitstream_id>Bitstream_1</bitstream_id>
        </assignment>
        <assignment page="0" partition_id="UBOOT">
            <raw_file_id>Raw_File_1</raw_file_id>
        </assignment>
    </assignments>
</pfg>
