BOARD=pcf4n
BOARD_CONFIG_REVISION=7

# Logic-team confirmed HPS peripheral routing. The I2C_EMAC controllers are
# Linux/U-Boot i2c2..i2c4 in EMAC order.
HPS_DATA_UART=0
HPS_UPGRADE_UART=1
HPS_DEVELOPMENT_CONSOLE_UART=1
# Keep TF-A on the same physical console as SPL/U-Boot during bring-up.  The
# upstream Agilex 5 TF-A default is UART0, which is PCF4N's MCU data channel.
ATF_CONSOLE_UART=1
# Retain verbose BL31 diagnostics until the first complete boot succeeds.
ATF_DEBUG=1
ATF_LOG_LEVEL=50
HPS_POWER_I2C_CONTROLLER=2
HPS_OPTICAL0_I2C_CONTROLLER=0
HPS_OPTICAL1_I2C_CONTROLLER=3
HPS_OPTICAL2_I3C_CONTROLLER=0
HPS_OPTICAL3_I3C_CONTROLLER=1
HPS_ETHERNET_EMAC=2
HPS_ETHERNET_MDIO=2
HPS_USB0_CONTROLLER=0
HPS_USB1_CONTROLLER=1

# The latest PCF4N PFG fixes U-Boot at 0x00300000..0x005fffff and starts the
# complete FPGA-first bitstream at 0x00600000. The generated PFG map is still
# required before changing the offset status to "confirmed".
QSPI_SIZE_BYTES=67108864
QSPI_UBOOT_OFFSET=0x00300000
QSPI_UBOOT_OFFSET_STATUS=placeholder
UBOOT_MAX_BYTES=3145728

# First-octet bit 1 is set (locally administered) and bit 0 is clear (unicast).
# Manufacturing must replace it or confirm an EEPROM format before release.
LOCAL_MAC_ADDRESS=02:50:43:46:34:01
LOCAL_MAC_STATUS=placeholder

EMMC_DEVICE=0
EMMC_BUS_WIDTH=4
EMMC_MAX_FREQUENCY=52000000
EMMC_VCC_UV=3300000
EMMC_VCCQ_UV=1800000
EMMC_RESET_GPIO_GLOBAL=27
EMMC_RESET_GPIO_BANK=1
EMMC_RESET_GPIO_OFFSET=3
EMMC_RESET_PACKAGE_PIN=AG123
KERNEL_PARTITION_BYTES=67108864
ROOTFS_PARTITION_BYTES=1073741824
GPT_DISK_UUID=d1c16676-7527-4f13-a400-6441e43e9b79
GPT_KERNEL_UUID=f7b0131a-c5ee-4457-b73d-61d3fea14939
GPT_ROOTFS_UUID=de7a7b1d-ffc4-4b28-a588-3ca98ca23401

TFTP_PREFIX=pcf4n
SCRIPT_ADDRESS=0x81000000
MANIFEST_ADDRESS=0x81100000
KERNEL_ITB_ADDRESS=0x82000000
KERNEL_LOAD_ADDRESS=0x86000000
ROOTFS_ADDRESS=0x100000000

# Conservative defaults for small cloud VMs. Local/CI builds may override
# them, for example: JOBS=4 make build-linux.
JOBS=${JOBS:-2}
MEMORY_HEAVY_JOBS=${MEMORY_HEAVY_JOBS:-1}
